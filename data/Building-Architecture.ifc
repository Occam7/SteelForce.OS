ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('SteelForce Standard Test'),'2;1');
FILE_NAME('steel_test.ifc','2024-07-10T10:00:00',('Gemini'),('SteelForce'),'Handcrafted','SteelForce.OS','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* 1. 全量归一化单位：毫米 */
#10=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#20=IFCUNITASSIGNMENT((#10));
#30=IFCPROJECT('0A1B2C3D4E5F6G7H8I9J0K',$,'SteelForce Test Project',$,$,$,$,$,#20);

/* 2. 材质定义：Q355 钢材 */
#100=IFCMATERIAL('Q355',$,$);
#101=IFCRELASSOCIATESMATERIAL('1111111111111111111111',$,$,$,(#500),#100);

/* 3. 钢梁构件 (IfcBeam) */
#500=IFCBEAM('2WUGYBphrFv8aLIFJCmiIk',$,'MainBeam_G1',$,$,#510,#520,$,.BEAM.);

/* 4. 几何：拉伸实体 (这是 Tekla 二开最关心的部分) */
#510=IFCLOCALPLACEMENT($,#511);
#511=IFCAXIS2PLACEMENT3D(IFCCARTESIANPOINT((0.,0.,0.)),$,$);
#520=IFCPRODUCTDEFINITIONSHAPE($,$,(#530));
#530=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#540));
#540=IFCEXTRUDEDAREASOLID(#550,#541,#542,5000.); /* 长度 5000mm */
#541=IFCAXIS2PLACEMENT3D(IFCCARTESIANPOINT((0.,0.,0.)),$,$);
#542=IFCDIRECTION((0.,0.,1.));
#550=IFCRECTANGULARPROFILEDEF(.AREA.,'H400x200',$,200.,400.); /* 宽200, 高400 */

/* 5. 属性集：力学参数 */
#600=IFCPROPERTYSINGLEVALUE('MomentOfInertia',$,IFCMOMENTOFINERTIAMEASURE(4.72E7),$);
#601=IFCPROPERTYSINGLEVALUE('ElasticModulus',$,IFCMODULUSOFELASTICITYMEASURE(206000.1),$);
#610=IFCPROPERTYSET('3y_abP04108BvIhy2WfsHn',$,'Pset_BeamCommon',$,(#600,#601));
#620=IFCRELDEFINESBYPROPERTIES('4y_abP04108BvIhy2WfsHo',$,$,$,(#500),#610);

ENDSEC;
END-ISO-10303-21;